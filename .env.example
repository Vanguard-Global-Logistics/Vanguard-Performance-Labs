# Vanguard Performance Labs — environment example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Jessie audio AI concierge ───────────────────────────────────
# Server-side only. Without a key, Jessie falls back to scripted routing.
# Audio playback uses the visitor's browser/OS speech engine and does not need a key.
ANTHROPIC_API_KEY=
# Optional model override. Leave blank to use the code default.
ANTHROPIC_MODEL=

# ── Professional inquiry delivery ───────────────────────────────
# Configure only the providers actually used in production and update the privacy policy.
# RESEND_API_KEY=
# HUBSPOT_TOKEN=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Order management — DISABLED FOR PUBLIC LAUNCH ───────────────
# Do not set this to true until product-specific legal, regulatory, operational,
# insurance, banking, and merchant-account review is complete. The public UI remains
# inquiry-only even when the backend is present.
ENABLE_ORDER_REQUESTS=false

# The variables below are dormant unless ENABLE_ORDER_REQUESTS=true and an approved
# commercial workflow is intentionally restored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ORDER_EMAIL_FROM="Vanguard Performance Labs <orders@yourdomain.com>"
ADMIN_TOKEN=
SHIPPING_WEBHOOK_URL=
WILLCALL_ADDRESS=
PAYMENT_PHONE=
OWNER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
