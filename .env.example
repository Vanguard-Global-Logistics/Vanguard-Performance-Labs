# Vanguard Performance Labs — local/Vercel environment template
# Never commit real secrets. Store production values in Vercel Project Settings → Environment Variables.

# Public canonical URL. Use the final https:// domain once connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Jessie AI concierge ─────────────────────────────────────────
# Server-side only. Without the key, Jessie falls back to scripted navigation.
ANTHROPIC_API_KEY=
# Optional override. The application provides a stable default.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Security operations ──────────────────────────────────────────
# normal = standard limits; elevated = tighter public mutation budgets;
# lockdown = disable guarded public writes while keeping read-only site pages online.
VPL_SECURITY_MODE=normal

# ── Production data ──────────────────────────────────────────────
# Required for durable orders, inquiries, newsletter subscribers, article workflow,
# and the private payment-evidence bucket.
# Create a Supabase project and run supabase/orders.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email delivery and owner alerts ─────────────────────────────
# Required before production orders or inquiries are accepted.
RESEND_API_KEY=
# Must use a sender/domain verified in Resend.
ORDER_EMAIL_FROM="Vanguard Performance Labs <orders@yourdomain.com>"
OWNER_EMAIL=

# ── Owner administration ─────────────────────────────────────────
# Long private token used to open /admin. Server-side only.
ADMIN_TOKEN=

# ── Order settlement and payment verification ────────────────────
# Business phone shown for pay-by-phone requests.
PAYMENT_PHONE=
# Shared HMAC secret used ONLY by an approved bank/payment reconciliation adapter
# calling /api/webhooks/payment-confirmed. Generate a long random value.
PAYMENT_CONFIRMATION_WEBHOOK_SECRET=

# ── Fulfillment / shipping ───────────────────────────────────────
# Pickup details included after payment confirmation.
WILLCALL_ADDRESS="Vanguard Performance Labs, <street>, <city ST zip> — Mon-Fri 9-4"
# ShipStation/Shippo/other approved fulfillment release endpoint when automated shipping is enabled.
SHIPPING_WEBHOOK_URL=
# REQUIRED whenever SHIPPING_WEBHOOK_URL is set. The runtime fails closed and will
# not transmit shipping data to an unauthenticated release endpoint.
SHIPPING_RELEASE_TOKEN=
# Shared HMAC secret used by the shipping provider/adapter when it posts carrier +
# tracking data to /api/webhooks/shipping-status. Machine webhooks may omit browser
# Origin headers, but the raw request body must pass this HMAC verification.
SHIPPING_WEBHOOK_SECRET=

# ── Optional owner SMS alerts ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
