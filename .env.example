# Vanguard Performance Labs — local/Vercel environment template
# Never commit real secrets. Store production values in Vercel Project Settings → Environment Variables.

# Public canonical URL. Use the final https:// domain once connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Jessie AI concierge ─────────────────────────────────────────
# Server-side only. Without the key, Jessie falls back to scripted navigation.
ANTHROPIC_API_KEY=
# Optional override. The application provides a stable default.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Security operations ──────────────────────────────────────────
# normal = standard limits; elevated = tighter public mutation budgets;
# lockdown = disable guarded public writes while keeping read-only site pages online.
VPL_SECURITY_MODE=normal

# ── Production data ──────────────────────────────────────────────
# Required for durable orders, inquiries, newsletter subscribers, and article workflow.
# Create a Supabase project and run supabase/orders.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email delivery and owner alerts ─────────────────────────────
# Required before production orders or inquiries are accepted.
RESEND_API_KEY=
# Must use a sender/domain verified in Resend.
ORDER_EMAIL_FROM="Vanguard Performance Labs <orders@yourdomain.com>"
OWNER_EMAIL=

# ── Owner administration ─────────────────────────────────────────
# Long private token used to open /admin. Server-side only.
ADMIN_TOKEN=

# ── Order settlement and fulfillment ─────────────────────────────
# Business phone shown for pay-by-phone requests.
PAYMENT_PHONE=
# Pickup details included after payment confirmation.
WILLCALL_ADDRESS="Vanguard Performance Labs, <street>, <city ST zip> — Mon-Fri 9-4"
# Optional Zapier/Make/ShipStation/Shippo release webhook.
SHIPPING_WEBHOOK_URL=

# ── Optional owner SMS alerts ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
